import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files
from PIL import Image
import io
uploaded = files.upload()

filename = next(iter(uploaded))
image_pil = Image.open(
    io.BytesIO(uploaded[filename])
).convert("RGB")
image = np.array(image_pil)
gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)
kernel = np.array([
    [-1, -1, -1],
    [-1,  8, -1],
    [-1, -1, -1]
], dtype=np.float32)
boundary = cv2.filter2D(
    gray,
    -1,
    kernel
)
boundary = cv2.convertScaleAbs(boundary)
plt.figure(figsize=(12, 6))
plt.subplot(1, 3, 1)
plt.imshow(image)
plt.title("Input Image")
plt.axis("off")
plt.subplot(1, 3, 2)
plt.imshow(gray, cmap="gray")
plt.title("Grayscale Image")
plt.axis("off")
plt.subplot(1, 3, 3)
plt.imshow(boundary, cmap="gray")
plt.title("Detected Boundary")
plt.axis("off")
plt.tight_layout()
plt.show()
cv2.imwrite(
    "Boundary_Detected_Image.jpg",
    boundary
)
print("Boundary detection completed successfully!")
print("Convolution Kernel Used:")
print(kernel)
print("Output saved as Boundary_Detected_Image.jpg")
