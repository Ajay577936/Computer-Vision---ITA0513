import cv2
from google.colab import files
import matplotlib.pyplot as plt

# Upload image
uploaded = files.upload()

# Read uploaded image
image_path = list(uploaded.keys())[0]
img = cv2.imread(image_path)

# Convert BGR to RGB
img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# Original size
print("Original Size:", img.shape)

# Scale Bigger (2x)
bigger = cv2.resize(img_rgb, None, fx=2, fy=2, interpolation=cv2.INTER_CUBIC)

# Scale Smaller (0.5x)
smaller = cv2.resize(img_rgb, None, fx=0.5, fy=0.5, interpolation=cv2.INTER_AREA)

# Display images
plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(img_rgb)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(bigger)
plt.title("Bigger Image (2x)")
plt.axis("off")

plt.subplot(1,3,3)
plt.imshow(smaller)
plt.title("Smaller Image (0.5x)")
plt.axis("off")

plt.show()

# Print sizes
print("Bigger Image Size :", bigger.shape)
print("Smaller Image Size:", smaller.shape)

# Save images
cv2.imwrite("bigger_image.jpg", cv2.cvtColor(bigger, cv2.COLOR_RGB2BGR))
cv2.imwrite("smaller_image.jpg", cv2.cvtColor(smaller, cv2.COLOR_RGB2BGR))

print("Images saved successfully!")
