import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files
uploaded = files.upload()
filename = next(iter(uploaded))
image = cv2.imread(filename)
if image is None:
    print("Error: Unable to read the image")
else:
    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    gx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
    gy = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)
    gradient = cv2.magnitude(gx.astype(np.float32),
                              gy.astype(np.float32))
    gradient = cv2.normalize(
        gradient, None, 0, 255, cv2.NORM_MINMAX
    ).astype(np.uint8)
    mask = gradient
    alpha = 1.0
    sharpened = cv2.addWeighted(
        gray, 1.0,
        mask, alpha,
        0
    )
    sharpened = np.clip(sharpened, 0, 255).astype(np.uint8)
plt.figure(figsize=(15, 8))
    plt.subplot(2, 3, 1)
    plt.imshow(image_rgb)
    plt.title("Input Image")
    plt.axis("off")
    plt.subplot(2, 3, 2)
    plt.imshow(gray, cmap="gray")
    plt.title("Grayscale Image")
    plt.axis("off")
    plt.subplot(2, 3, 3)
    plt.imshow(gx, cmap="gray")
    plt.title("X Gradient")
    plt.axis("off")
    plt.subplot(2, 3, 4)
    plt.imshow(gy, cmap="gray")
    plt.title("Y Gradient")
    plt.axis("off")
    plt.subplot(2, 3, 5)
    plt.imshow(mask, cmap="gray")
    plt.title("Gradient Mask")
    plt.axis("off")
    plt.subplot(2, 3, 6)
    plt.imshow(sharpened, cmap="gray")
    plt.title("Sharpened Image")
    plt.axis("off")
    plt.tight_layout()
    plt.show()
    cv2.imwrite(
        "Gradient_Masking_Sharpened.jpg",
        sharpened
    )
    print("Gradient Masking Sharpening Completed Successfully!")
