import cv2
import matplotlib.pyplot as plt
from google.colab import files

# Upload Image
uploaded = files.upload()

# Read the uploaded image
image_path = list(uploaded.keys())[0]
img = cv2.imread(image_path)

# Convert BGR to RGB
img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# Get image dimensions
(h, w) = img.shape[:2]
center = (w // 2, h // 2)

# Rotate 90° Clockwise
clockwise = cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)

# Rotate 90° Counter Clockwise
counter_clockwise = cv2.rotate(img, cv2.ROTATE_90_COUNTERCLOCKWISE)

# Display Images
plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(img)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(clockwise)
plt.title("90° Clockwise")
plt.axis("off")

plt.subplot(1,3,3)
plt.imshow(counter_clockwise)
plt.title("90° Counter Clockwise")
plt.axis("off")

plt.show()

# Save Rotated Images
cv2.imwrite("clockwise.jpg", cv2.cvtColor(clockwise, cv2.COLOR_RGB2BGR))
cv2.imwrite("counter_clockwise.jpg", cv2.cvtColor(counter_clockwise, cv2.COLOR_RGB2BGR))

print("Rotation completed successfully!")
